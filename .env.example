# ─────────────────────────────────────────────────────────────
# Call Data — environment variables
# Copy to .env.local for local dev, or set in Coolify for prod.
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:5000
# Comma-separated list of email domains allowed to sign in (e.g. peechstudio.com)
ALLOWED_EMAIL_DOMAINS=peechstudio.com
# Secret used to authorize the /api/sync, /api/process, /api/retention cron endpoints
SYNC_SECRET=
# RGPD: delete stored call videos older than N days (0 = keep forever)
RETENTION_MEDIA_DAYS=0

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full DB access — NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for call media (video/audio). Create it in Supabase Storage.
SUPABASE_MEDIA_BUCKET=call-media

# ── Recall.ai (primary capture — everyone except sales) ───────
RECALL_API_KEY=
# Region host, e.g. us-east-1 / eu-central-1 (matches your Recall workspace region)
RECALL_REGION=us-east-1
# Secret to validate incoming Recall webhooks (set the same value in Recall).
RECALL_WEBHOOK_SECRET=
# Comma-separated emails/domains to EXCLUDE from auto-recording (the sales team → Attio).
RECALL_EXCLUDE=sales@peechstudio.com

# ── Attio (commercial calls) ──────────────────────────────────
# Bearer token from Attio > Settings > Developers > Access tokens
ATTIO_API_KEY=

# ── Google Workspace (Meet transcripts + recordings via Drive) ─
# Service account with domain-wide delegation. Provide EITHER the raw
# JSON (base64-encoded, recommended for Coolify) OR a file path.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# The workspace user whose Drive is impersonated to read Meet Recordings.
# Usually the account that owns the shared "Meet Recordings" folder.
GOOGLE_IMPERSONATE_SUBJECT=malik@peechstudio.com
# Optional: restrict Drive scan to a specific folder id (the Meet Recordings folder).
GOOGLE_MEET_FOLDER_ID=

# Separate OAuth Web client (NOT the service account above) used to connect
# each team member's Google Calendar to Recall — one-time per-person consent
# at /auth/calendar/connect. Google Cloud Console → Credentials → OAuth
# client ID → Web application. Scopes: calendar.events.readonly + userinfo.email.
# Redirect URI: <APP_URL>/auth/calendar/callback
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=

# ── Airtable (client / project code reference for categorization) ─
# Personal access token with data.records:read on the base below.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appYFl5MvR7VeL0uB
AIRTABLE_PROJECTS_TABLE=tbl0Pij0JqZFD9Ijr
# View already filtered to active projects (En cours / Finalisation).
AIRTABLE_PROJECTS_VIEW=viwsjtvRuPucNQXXR

# ── AI ────────────────────────────────────────────────────────
# Anthropic — summaries & Q&A
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Voyage AI — embeddings for semantic / cross-call search
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ── Transcription FALLBACK (STT — only when a source has no transcript) ─
# Recall/Attio/Meet already provide transcripts, so this is rarely used.
# Which engine: gladia | whisper
TRANSCRIPTION_PROVIDER=gladia
GLADIA_API_KEY=
# Self-hosted Whisper endpoint (if TRANSCRIPTION_PROVIDER=whisper)
WHISPER_URL=
